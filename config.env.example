# =====================================================================
#  astra-silent-monitor — конфигурация
#  Скопируйте в config.env и заполните. config.env НЕ коммитить в git.
# =====================================================================

# Часовой пояс сервера и веб-интерфейса
TZ_NAME="Europe/Moscow"

# ---------------------------------------------------------------------
# Админская сеть (единственная, откуда есть вход на сервер)
# ---------------------------------------------------------------------
ADMIN_IF="ens192"                 # интерфейс админской сети
ADMIN_ADDR="192.168.100.10/24"    # IP/маска сервера в админской сети
ADMIN_GW=""                       # шлюз; лучше оставить пустым (нет выхода никуда)
ADMIN_ALLOWED="192.168.100.20/32" # кто может заходить на SSH и веб (через пробел)
ADMIN_NTP=""                      # NTP-сервер в админской сети (пусто = не синхронизировать)
ADMIN_SMTP=""                     # почта для оповещений в админской сети, формат IP:порт (пусто = нет)

# ---------------------------------------------------------------------
# Наблюдаемые сети: "имя  интерфейс  IP_сервера/маска"
# Имя — латиница без пробелов, используется в hosts.txt
# Узнать интерфейсы и MAC:  ip -br link
# ---------------------------------------------------------------------
NETS=(
  "net1  ens224  10.1.0.250/24"
  "net2  ens256  10.2.0.250/24"
  "net3  ens161  10.3.0.250/24"
  "net4  ens193  10.4.0.250/24"
  "net5  ens225  10.5.0.250/24"
  "net6  ens257  10.6.0.250/24"
  "net7  ens162  10.7.0.250/24"
#  "net8  ens194  10.8.0.250/24"
)

# ---------------------------------------------------------------------
# Режим «невидимости»
# ---------------------------------------------------------------------
# yes — сервер отвечает на ARP только узлам из hosts.txt (для сетей,
#       где hosts.txt пуст, — всем узлам подсети)
ARP_STEALTH="yes"

# yes — разрешать исходящие соединения только к узлам из hosts.txt,
#       а не ко всей подсети (для сетей без узлов — ко всей подсети)
STRICT_TARGETS="yes"

# ---------------------------------------------------------------------
# SSH
# ---------------------------------------------------------------------
SSH_ADMIN_USER="admin"            # пользователь, под которым входите
# yes — только по ключу. Скрипт НЕ выключит пароли, если у пользователя
#       нет ~/.ssh/authorized_keys (защита от потери доступа)
SSH_KEYS_ONLY="yes"

# ---------------------------------------------------------------------
# Встроенные механизмы защиты Astra SE (если доступны)
# ---------------------------------------------------------------------
ASTRA_ZPS="yes"        # замкнутая программная среда (astra-digsig-control)
ASTRA_MIC="yes"        # мандатный контроль целостности (astra-mic-control)
ASTRA_PTRACE="yes"     # запрет ptrace (astra-ptrace-lock)

# ---------------------------------------------------------------------
# Агент для Windows (скачивается на машине с интернетом)
# Должен быть той же основной версии, что и сервер (7.0.x)
# ---------------------------------------------------------------------
AGENT_VERSION="7.0.10"
